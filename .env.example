# Supabase Database Password
# Copy file này thành .env và điền mật khẩu thực tế vào
SUPABASE_DB_PASSWORD=your_supabase_db_password_here

# JWT Secret Key (256-bit Hex)
JWT_SECRET=your_custom_jwt_secret_key_here

# Google OAuth2 Credentials (TASK #99064)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

