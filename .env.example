# Supabase Database Password
# Copy file này thành .env và điền mật khẩu thực tế vào
SUPABASE_DB_PASSWORD=your_supabase_db_password_here

# JWT Secret Key (256-bit Hex)
JWT_SECRET=your_custom_jwt_secret_key_here

# Google OAuth2 Credentials (TASK #99064)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Facebook OAuth2 Credentials (TASK #99065)
FACEBOOK_CLIENT_ID=your_facebook_client_id_here
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret_here

# Slack Incoming Webhook (TASK #99079)
SLACK_WEBHOOK_URL=your_slack_webhook_url_here

# Email thông báo đơn hàng mới (TASK #NOTIFICATION-EMAIL)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_email_here
MAIL_PASSWORD=your_smtp_app_password_here
ADMIN_NOTIFICATION_EMAIL=admin_receive_email_here
